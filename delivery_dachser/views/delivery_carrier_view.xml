<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_delivery_carrier_form" model="ir.ui.view">
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position='before'>
                <page
                    string="DACHSER Configuration"
                    attrs="{'invisible': [('delivery_type', '!=', 'dachser')]}"
                >
                    <group>
                        <group>
                            <field
                                name="dachser_user"
                                attrs="{'required': [('delivery_type', '=', 'dachser')]}"
                            />
                            <field
                                name="dachser_password"
                                password="True"
                                attrs="{'required': [('delivery_type', '=', 'dachser')]}"
                            />
                            <field
                                name="dachser_code"
                                attrs="{'required': [('delivery_type', '=', 'dachser')]}"
                            />
                            <field
                                name="dachser_product_code"
                                attrs="{'required': [('delivery_type', '=', 'dachser')]}"
                            />
                            <field
                                name="dachser_expenses"
                                attrs="{'required': [('delivery_type', '=', 'dachser')]}"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
